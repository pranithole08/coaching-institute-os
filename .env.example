# ==============================================================================
# Coaching Institute OS — Environment Configuration
# ==============================================================================

# Server Port (default: 3001)
PORT=3001
NODE_ENV=production

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Connect to Any Database)
# ------------------------------------------------------------------------------
# Option A: Local SQLite (Default, Zero-Setup)
DATABASE_URL="file:./prisma/dev.db"

# Option B: Cloud LibSQL / Turso (Global Edge SQLite, Perfect for Vercel/Serverless)
# DATABASE_URL="libsql://your-database-name.turso.io?authToken=your-turso-token"

# Option C: PostgreSQL (Supabase / Neon / Railway / AWS RDS)
# DATABASE_URL="postgresql://postgres:password@db.xyz.supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# 2. UNIVERSAL AI ENGINE (Connect to Any AI Model)
# ------------------------------------------------------------------------------
# Available Providers: openai | gemini | groq | deepseek | ollama | custom
AI_PROVIDER="openai"

# API Key (Required for cloud providers; leave blank for local Ollama)
AI_API_KEY=""

# Custom Base URL (Auto-set if left blank, or customize for enterprise proxies)
# OpenAI:    https://api.openai.com/v1
# Gemini:    https://generativelanguage.googleapis.com/v1beta/openai
# Groq:      https://api.groq.com/openai/v1
# DeepSeek:  https://api.deepseek.com/v1
# Ollama:    http://localhost:11434
AI_BASE_URL="https://api.openai.com/v1"

# Model Name
# OpenAI:    gpt-4o-mini, gpt-4o
# Gemini:    gemini-2.0-flash, gemini-1.5-flash
# Groq:      llama-3.3-70b-versatile, llama-3.1-8b-instant
# DeepSeek:  deepseek-chat, deepseek-reasoner
# Ollama:    llama3.1, qwen2.5, mistral, llava
AI_MODEL="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 3. WHATSAPP BUSINESS CLOUD API (Official Meta Graph API)
# ------------------------------------------------------------------------------
# WHATSAPP_ACCESS_TOKEN=EAAG...
# WHATSAPP_PHONE_NUMBER_ID=123456789012345
# WHATSAPP_API_VERSION=v21.0
# WHATSAPP_VERIFY_TOKEN=your-webhook-verification-secret
# WHATSAPP_SIMULATION=0
